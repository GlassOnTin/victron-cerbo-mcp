# Copy to ~/.config/victron-cerbo/sensor-daemon.env and fill in your Cerbo password:
#   mkdir -p ~/.config/victron-cerbo
#   cp deploy/sensor-daemon.env.example ~/.config/victron-cerbo/sensor-daemon.env
#   chmod 600 ~/.config/victron-cerbo/sensor-daemon.env

VICTRON_HOST=venus.local
VICTRON_PORT=8883
VICTRON_READ_ONLY=true
CERBO_MQTT_PASSWORD=
