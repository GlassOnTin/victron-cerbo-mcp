[Unit]
Description=Victron Cerbo GX Sensor Daemon for KDE Plasma System Monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Code/victron-cerbo-mcp
Environment="VICTRON_HOST=venus.local"
Environment="VICTRON_PORT=8883"
Environment="VICTRON_READ_ONLY=true"
EnvironmentFile=-%h/.config/victron-cerbo/sensor-daemon.env
ExecStart=%h/.local/bin/uv run victron-sensor-daemon
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
