# Copy to bridge.env (gitignored). Loaded by systemd via EnvironmentFile=.

# --- Serial / Modbus bus (shared by all meters on the RS485 chain) ---
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=9600
SERIAL_PARITY=N
SERIAL_STOPBITS=1
MODBUS_TIMEOUT_S=1.0
MODBUS_RETRIES=3

# --- MQTT (Cerbo dbus-flashmq) ---
MQTT_HOST=192.168.0.208
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_TLS_INSECURE=true
MQTT_USERNAME=pi-bridge
MQTT_PASSWORD=replace-me
MQTT_CLIENT_ID=sdm120-bridge
MQTT_KEEPALIVE_S=30

# --- Meters (one numbered block per slave on the RS485 chain) ---
# Per meter: ADDR + ROLE + TOPIC required; NAME + POWER_SIGN optional.
# ROLE in {grid, pv} selects payload shape (dbus-mqtt-grid vs dbus-mqtt-pv).
# POWER_SIGN flips the meter's raw sign if the CT is wired the wrong way.

METER_1_NAME=grid
METER_1_ADDR=1
METER_1_ROLE=grid
METER_1_TOPIC=victron/grid/sdm120
METER_1_POWER_SIGN=1

METER_2_NAME=pv
METER_2_ADDR=2
METER_2_ROLE=pv
METER_2_TOPIC=victron/pv/sdm120
METER_2_POWER_SIGN=1

# --- Behaviour ---
PUBLISH_PERIOD_S=2.0
LOG_LEVEL=INFO
