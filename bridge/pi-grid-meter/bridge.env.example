# Copy to bridge.env (gitignored). Loaded by systemd via EnvironmentFile=.

# --- Serial / Modbus ---
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=9600
SERIAL_PARITY=N
SERIAL_STOPBITS=1
MODBUS_ADDR=1
MODBUS_TIMEOUT_S=1.0
MODBUS_RETRIES=3

# --- MQTT (Cerbo dbus-flashmq) ---
MQTT_HOST=192.168.0.208
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_TLS_INSECURE=true
MQTT_USERNAME=pi-bridge
MQTT_PASSWORD=replace-me
MQTT_CLIENT_ID=sdm120-grid-bridge
MQTT_TOPIC=victron/grid/sdm120
MQTT_KEEPALIVE_S=30

# --- Behaviour ---
PUBLISH_PERIOD_S=2.0
POWER_SIGN=1
LOG_LEVEL=INFO
