# /etc/cerbo-mcp.env — full-access Connector (desktop browser)
# Mode 0600, owned by root or the service user.

VICTRON_HOST=192.168.0.208
VICTRON_USERNAME=pi-bridge
CERBO_MQTT_PASSWORD=__CERBO_REMOTE_CONSOLE_PASSWORD__
VICTRON_READ_ONLY=false

VICTRON_TRANSPORT=http
VICTRON_HTTP_HOST=127.0.0.1
VICTRON_HTTP_PORT=8766
VICTRON_READ_ONLY_MODE=false

# GitHub OAuth App "Cerbo Connector (full)" — callback:
# https://cerbo.<your-domain>/auth/callback
OAUTH_PUBLIC_BASE_URL=https://cerbo.<your-domain>
OAUTH_UPSTREAM_CLIENT_ID=__GITHUB_CLIENT_ID__
OAUTH_UPSTREAM_CLIENT_SECRET=__GITHUB_CLIENT_SECRET__
OAUTH_ALLOWED_GH_USERS=GlassOnTin
